# Copy to .env.local (git-ignored) and adjust. Only EXPO_PUBLIC_* values are bundled
# into the app, so NEVER put secrets here. Server-side API keys (e.g. a future vision
# API) must live behind our own backend, not in the mobile bundle.

# Recognition pipeline mode: "mock" (development fixtures) or "offline" (real stages; most not implemented yet)
EXPO_PUBLIC_RECOGNITION_MODE=mock

# Base URL of the future CardVariant recognition backend (unused in Phase 1)
EXPO_PUBLIC_API_BASE_URL=
